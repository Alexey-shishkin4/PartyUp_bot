BOT_TOKEN=
STEAM_API_KEY=
# FACEIT Data API, серверный ключ для /faceit и /cs2.
FACEIT_API_KEY=
# WOK Steam API для CS2, если FACEIT_API_KEY пустой.
WOK_API_KEY=
# Необязательный ключ Deadlock API. Команда /deadlock работает и без ключа.
DEADLOCK_API_KEY=
ADMIN_IDS=
DEVELOPER_IDS=
POSTGRES_PASSWORD=

API_FORTNITE_KEY=
API_FORTNITE_DAILY_LIMIT=10000
# fortnite-api.com — резервный источник общего наигрыша Battle Royale.
FORTNITE_API_KEY=

# Valorant: ugiAPI — основная статистика, HenrikDev — определение сервера и резервная статистика.
UGI_API_KEY=
HENRIKDEV_API_KEY=
# League of Legends использует OP.GG без ключа. Riot Games API служит резервом для LoL и Valorant.
RIOT_API_KEY=

# JWT из PUBG Developer Portal для ранга текущего сезона и консольной статистики.
PUBG_API_KEY=
# Увеличивай только после подтверждения нового лимита в PUBG Developer Portal.
PUBG_API_REQUESTS_PER_MINUTE=10

# Включить /test и маркированные тестовые анкеты в ленте.
ENABLE_TEST_PROFILES=false

# Укажите фактическое место хранения и контакт для /privacy.
DATA_LOCATION=локальный компьютер владельца
OPERATOR_CONTACT=администратор бота
