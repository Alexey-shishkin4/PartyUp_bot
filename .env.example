# Токен Telegram-бота из @BotFather. Обязателен.
BOT_TOKEN=

# Пароль пользователя PostgreSQL. Укажите случайный пароль перед первым запуском.
POSTGRES_PASSWORD=
# POSTGRES_USER=partyup
# POSTGRES_DB=partyup

# Необязательный ключ Steam Web API. Без него используются публичные страницы Steam.
STEAM_API_KEY=

# Числовые Telegram ID через запятую. Свой ID можно получить через команду /id.
ADMIN_IDS=
DEVELOPER_IDS=

# Включить /test и маркированные тестовые анкеты в ленте.
ENABLE_TEST_PROFILES=false

# Укажите фактическое место хранения и контакт для /privacy.
DATA_LOCATION=локальный компьютер владельца
OPERATOR_CONTACT=администратор бота
