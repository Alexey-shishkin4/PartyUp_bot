# Без BOT_TOKEN запускается только демо с вымышленными анкетами.
BOT_TOKEN=
# Необязательный серверный ключ для импорта библиотек через Steam Web API.
STEAM_API_KEY=
# link: импорт по ссылке, внешний HTTPS-адрес не нужен.
# openid: подтверждённый вход, нужен внешний HTTPS-адрес.
STEAM_MODE=link
PUBLIC_URL=http://127.0.0.1:8766
# Telegram ID администраторов через запятую.
ADMIN_IDS=
# Telegram ID разработчиков: доступ к /dev, просмотру и редактированию анкет.
DEVELOPER_IDS=
# Страны хранения данных: замените значением вашего хостинга.
DATA_LOCATION=локальный компьютер владельца
OPERATOR_CONTACT=администратор бота
HOST=127.0.0.1
PORT=8766
# DATABASE_URL=sqlite:///data/bot.sqlite3
