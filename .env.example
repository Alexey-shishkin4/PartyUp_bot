BOT_TOKEN=
STEAM_API_KEY=
# Необязательный ключ Deadlock API. Команда /deadlock работает и без ключа.
DEADLOCK_API_KEY=
ADMIN_IDS=
DEVELOPER_IDS=
POSTGRES_PASSWORD=

API_FORTNITE_KEY=
API_FORTNITE_DAILY_LIMIT=10000
# fortnite-api.com — резервный источник общего наигрыша Battle Royale.
FORTNITE_API_KEY=

# Valorant: ugiAPI — основная статистика, HenrikDev — определение сервера и резервная статистика.
UGI_API_KEY=
HENRIKDEV_API_KEY=
# Riot Games API: League of Legends и резервное определение сервера Valorant.
RIOT_API_KEY=

# Включить /test и маркированные тестовые анкеты в ленте.
ENABLE_TEST_PROFILES=false

# Укажите фактическое место хранения и контакт для /privacy.
DATA_LOCATION=локальный компьютер владельца
OPERATOR_CONTACT=администратор бота
